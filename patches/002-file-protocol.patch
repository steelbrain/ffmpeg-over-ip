+}
+
+static int fio_read_dir_entry(URLContext *h, AVIODirEntry **next)
+{
+    FileContext *c = h->priv_data;
+    fio_dirent e;
+    int ret;
+
+    *next = ff_alloc_dir_entry();
+    if (!*next)
+        return AVERROR(ENOMEM);
+    ret = fio_readdir(c->fdir, &e);
+    if (ret <= 0) {
+        av_freep(next);
+        return ret < 0 ? AVERROR(errno) : 0;
+    }
+
+    switch (e.type) {
+    case FIO_DT_FILE: (*next)->type = AVIO_ENTRY_FILE;             break;
+    case FIO_DT_DIR:  (*next)->type = AVIO_ENTRY_DIRECTORY;        break;
+    case FIO_DT_LINK: (*next)->type = AVIO_ENTRY_SYMBOLIC_LINK;    break;
+    case FIO_DT_FIFO: (*next)->type = AVIO_ENTRY_NAMED_PIPE;       break;
+    case FIO_DT_CHR:  (*next)->type = AVIO_ENTRY_CHARACTER_DEVICE; break;
+    case FIO_DT_BLK:  (*next)->type = AVIO_ENTRY_BLOCK_DEVICE;     break;
+    case FIO_DT_SOCK: (*next)->type = AVIO_ENTRY_SOCKET;           break;
+    default:          (*next)->type = AVIO_ENTRY_UNKNOWN;          break;
+    }
+    if (e.has_stat) {
+        (*next)->size = e.size;
+        (*next)->filemode = e.perm;
+        (*next)->modification_timestamp = INT64_C(1000000) * e.mtime;
+    }
+    (*next)->name = av_strdup(e.name);
+    if (!(*next)->name) {
+        avio_free_directory_entry(next);
+        return AVERROR(ENOMEM);
+    }
+    return 0;
 }
 
