+        const char *dirname = h->filename;
+        av_strstart(dirname, "file:", &dirname);
+        c->fdir = fio_opendir(dirname);
+        return c->fdir ? 0 : AVERROR(errno);
+    }
+    {
 #if HAVE_LSTAT
     FileContext *c = h->priv_data;
 
-    c->dir = opendir(h->filename);
+    c->dir = opendir(h->filename); // fio-safe: not tunneled
     if (!c->dir)
         return AVERROR(errno);
 
@@ -344,10 +378,52 @@ static int file_open_dir(URLContext *h)
 #else
     return AVERROR(ENOSYS);
 #endif /* HAVE_LSTAT */
