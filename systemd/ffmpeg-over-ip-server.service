[Unit]
Description=ffmpeg-over-ip Transcode Server Daemon
Documentation=https://github.com/primechuck/ffmpeg-over-ip
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/ffmpeg-over-ip-server --config /etc/ffmpeg-over-ip/server.jsonc
Restart=always
RestartSec=3s

# Environment defaults fallback if config file is absent
Environment=FFMPEG_OVER_IP_SERVER_ADDRESS=0.0.0.0:5050
Environment=FFMPEG_OVER_IP_SERVER_SHORT_CIRCUIT_READ=/media

# Performance & Security tuning
LimitNOFILE=65536
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SYS_NICE

[Install]
WantedBy=multi-user.target
